---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article id={product.slug} data-product-card={product.slug} class="product-card card">
  <a class="product-card__image-link" href={`/products/${product.slug}/`} aria-label={`查看${product.displayName}详情`}>
    <img class="product-card__image" src={product.image} alt={product.imageAlt} width="1254" height="1254" loading="lazy" decoding="async" />
  </a>
  <p class="product-card__index">实际产品</p>
  <h3>{product.confirmedName}</h3>
  <p>{product.summary}</p>
  <dl>
    <div><dt>常见原料</dt><dd>{product.material}</dd></div>
    <div><dt>常见工艺</dt><dd>{product.process}</dd></div>
    <div><dt>选型重点</dt><dd>{product.selectionFocus.slice(0, 2).join('、')}</dd></div>
  </dl>
  <a class="text-link" href={`/products/${product.slug}/`}>查看参数与采购事项</a>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    scroll-margin-top: 120px;
    border-color: rgb(255 255 255 / 58%);
    color: #1f2429;
    background: rgb(244 244 242 / 94%);
    box-shadow: 0 18px 48px rgb(9 17 26 / 16%);
    backdrop-filter: blur(12px);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .product-card__image-link {
    display: block;
    margin: -28px -28px 24px;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: #fff;
  }

  .product-card__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.025);
  }

  .product-card:hover,
  .product-card.is-highlighted {
    border-color: #b8322a;
    box-shadow: 0 22px 54px rgb(9 17 26 / 28%);
    transform: translateY(-6px);
  }

  .product-card__index {
    margin: 0 0 16px;
    color: #b8322a;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  h3 {
    font-size: 1.25rem;
  }

  .product-card > p:not(.product-card__index) {
    color: #58616b;
  }

  dl {
    margin: 8px 0 22px;
  }

  dl div {
    display: grid;
    grid-template-columns: 78px 1fr;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-line);
  }

  dt {
    color: #67717b;
  }

  dd {
    margin: 0;
  }

  .text-link {
    margin-top: auto;
    color: #9f2a24;
    font-weight: 800;
  }

  .text-link:hover {
    color: #751d18;
  }

  @media (max-width: 700px) {
    .product-card__image-link {
      margin: -22px -22px 22px;
    }
  }
</style>
