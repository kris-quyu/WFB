---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import PlaceholderNotice from '../components/PlaceholderNotice.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { applications, faqItems } from '../data/content';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`无纺布产品与生产资料｜${siteConfig.shortName}`}
  description="传统小型无纺布生产企业官网建设版本，集中展示产品、生产现场、设备、质量流程、应用与采购知识。"
>
  <section class="immersive-hero">
    <img
      class="immersive-hero__image"
      src="/images/nonwoven-production-line.png"
      alt="绿色无纺布生产设备正在加工白色卷材的现场照片"
      width="1680"
      height="945"
      fetchpriority="high"
    />
    <div class="immersive-hero__overlay" aria-hidden="true"></div>
    <div class="container immersive-hero__content">
      <div class="immersive-hero__copy">
        <p class="eyebrow">NONWOVEN MANUFACTURING</p>
        <h1>
          <span>把产品参数、</span>
          <span>生产现场和</span>
          <span>质量流程说清楚</span>
        </h1>
        <p>{siteConfig.description}</p>
        <div class="button-row">
          <a class="button immersive-hero__primary" href="/products/">查看产品介绍</a>
          <a class="button immersive-hero__secondary" href="#contact">准备询价信息</a>
        </div>
      </div>
      <p class="immersive-hero__caption">
        <strong>真实生产现场</strong>
        用户提供的设备现场图；设备名称、型号、数量与工艺作用仍待企业确认。
      </p>
    </div>
  </section>

  <div class="homepage-continuation">
  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">能力证据</p>
        <h2>先看可核实的资料</h2>
        <p>不使用夸张口号，用真实现场、设备用途、检查流程和记录方式说明企业能力。</p>
      </div>
      <div class="grid grid--3">
        <EvidenceCard index="01" title="工厂实力" description="展示生产、原料、仓储和发货环节；具体规模数据等待企业核实。" href="/factory/" />
        <EvidenceCard index="02" title="生产设备" description="展示用户提供的设备现场，并为设备名称、型号和数量保留核实字段。" href="/equipment/" />
        <EvidenceCard index="03" title="质量检测" description="先展示通用检查流程，实际标准、设备和频次以企业资料为准。" href="/quality/" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">应用场景</p>
        <h2>从用途反推产品要求</h2>
      </div>
      <div class="grid grid--3">
        {applications.slice(0, 6).map((item) => <article class="card"><h3>{item.name}</h3><p>{item.focus}</p><p><strong>询价准备：</strong>{item.inquiryInput}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container faq-preview">
      <div class="section-heading">
        <p class="section-heading__eyebrow">常见问题</p>
        <h2>采购前经常需要确认</h2>
      </div>
      <div>
        {faqItems.slice(0, 3).map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        <a class="button button--outline" href="/knowledge/">查看全部 FAQ 与知识文章</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container"><PlaceholderNotice /></div>
  </section>
  <div id="contact" class="container section"><ContactPanel /></div>
  </div>
</BaseLayout>

<style>
  .immersive-hero {
    --showcase-red: #b8322a;
    --showcase-red-dark: #90251f;
    --showcase-slate: #405066;
    --showcase-ink: #1f2429;
    --showcase-paper: #f4f4f2;
  }

  .immersive-hero {
    position: relative;
    min-height: clamp(600px, calc(100svh - 112px), 760px);
    overflow: hidden;
    color: white;
    background: var(--showcase-slate);
    isolation: isolate;
  }

  .immersive-hero__image,
  .immersive-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .immersive-hero__image {
    z-index: -2;
    object-fit: cover;
    object-position: center;
  }

  .immersive-hero__overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(25 37 52 / 94%) 0%, rgb(52 66 85 / 78%) 47%, rgb(52 66 85 / 22%) 100%),
      linear-gradient(0deg, rgb(20 28 38 / 40%) 0%, transparent 48%);
  }

  .immersive-hero__content {
    position: relative;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(72px, 9vw, 126px) 92px;
  }

  .immersive-hero__copy {
    max-width: 690px;
  }

  .immersive-hero .eyebrow {
    color: #f0bbb7;
  }

  .immersive-hero h1 {
    margin: 0;
    color: white;
    font-size: clamp(2.8rem, 5vw, 4.9rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
    text-shadow: 0 5px 28px rgb(8 15 23 / 28%);
  }

  .immersive-hero h1 span {
    display: block;
  }

  .immersive-hero__copy > p:not(.eyebrow) {
    max-width: 610px;
    margin: 28px 0;
    color: rgb(255 255 255 / 82%);
    font-size: 1.08rem;
  }

  .immersive-hero__primary {
    border-color: var(--showcase-red);
    background: var(--showcase-red);
  }

  .immersive-hero__primary:hover {
    border-color: var(--showcase-red-dark);
    background: var(--showcase-red-dark);
  }

  .immersive-hero__secondary {
    border-color: rgb(255 255 255 / 68%);
    color: white;
    background: rgb(31 36 41 / 18%);
    backdrop-filter: blur(8px);
  }

  .immersive-hero__secondary:hover {
    border-color: white;
    background: rgb(255 255 255 / 14%);
  }

  .immersive-hero__caption {
    position: absolute;
    right: 0;
    bottom: 24px;
    left: 0;
    margin: 0;
    color: rgb(255 255 255 / 68%);
    font-size: 0.82rem;
  }

  .immersive-hero__caption strong {
    margin-right: 12px;
    color: white;
  }

  .homepage-continuation {
    --home-slate: #405066;
    --home-paper: #f2f2f2;
    --color-forest: var(--home-slate);
    --color-forest-dark: #303d50;
    --color-accent: #b8322a;
    --color-warm-gray: var(--home-paper);
    --color-paper: #ffffff;
    --color-muted: #5d6771;
    background: var(--home-paper);
  }

  .homepage-continuation :global(.placeholder-notice) {
    border-left-color: var(--color-accent);
    background: #e7e9ec;
  }

  .faq-preview {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 60px;
  }

  details {
    border-top: 1px solid var(--color-line);
  }

  summary {
    padding: 18px 0;
    color: var(--color-forest-dark);
    font-weight: 800;
    cursor: pointer;
  }

  details p {
    margin-top: 0;
    color: var(--color-muted);
  }

  @media (max-width: 880px) {
    .faq-preview {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 720px) {
    .immersive-hero {
      min-height: 690px;
    }

    .immersive-hero__image {
      object-position: 43% center;
    }

    .immersive-hero__overlay {
      background:
        linear-gradient(0deg, rgb(22 31 43 / 98%) 0%, rgb(35 48 65 / 88%) 54%, rgb(52 66 85 / 20%) 100%),
        linear-gradient(90deg, rgb(28 39 53 / 46%), transparent);
    }

    .immersive-hero__content {
      justify-content: flex-end;
      padding-block: 230px 74px;
    }

    .immersive-hero h1 {
      font-size: clamp(2.25rem, 10vw, 3.1rem);
      letter-spacing: -0.045em;
    }

    .immersive-hero__copy > p:not(.eyebrow) {
      margin: 22px 0;
      font-size: 1rem;
    }

    .immersive-hero__caption {
      bottom: 16px;
      padding-right: 8px;
      font-size: 0.72rem;
      line-height: 1.5;
    }

    .immersive-hero__caption strong {
      display: block;
      margin-right: 0;
    }

  }
</style>
