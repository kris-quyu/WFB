---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`无纺布产品与生产资料｜${siteConfig.shortName}`}
  description="传统小型无纺布生产企业官网建设版本，集中展示企业真实生产现场，并提供产品、设备、应用与采购资料的独立入口。"
>
  <section class="immersive-hero">
    <img
      class="immersive-hero__image"
      src="/images/nonwoven-production-line.png"
      alt="无纺布生产设备正在加工白色卷材的现场照片"
      width="1680"
      height="945"
      fetchpriority="high"
    />
    <div class="immersive-hero__overlay" aria-hidden="true"></div>
    <div class="container immersive-hero__content">
      <div class="immersive-hero__copy">
        <p class="eyebrow">NONWOVEN MANUFACTURING</p>
        <h1>
          <span>把产品参数、</span>
          <span>生产现场和</span>
          <span>质量流程说清楚</span>
        </h1>
        <p>{siteConfig.description}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .immersive-hero {
    --showcase-slate: #405066;
    position: relative;
    min-height: calc(100svh - 112px);
    overflow: hidden;
    color: white;
    background: var(--showcase-slate);
    isolation: isolate;
  }

  .immersive-hero__image,
  .immersive-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .immersive-hero__image {
    z-index: -2;
    object-fit: cover;
    object-position: center;
  }

  .immersive-hero__overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(31 43 58 / 94%) 0%, rgb(64 80 102 / 76%) 47%, rgb(64 80 102 / 18%) 100%),
      linear-gradient(0deg, rgb(22 30 41 / 38%) 0%, transparent 48%);
  }

  .immersive-hero__content {
    display: flex;
    min-height: inherit;
    align-items: center;
    padding-block: clamp(64px, 8vw, 112px);
  }

  .immersive-hero__copy {
    max-width: 690px;
  }

  .immersive-hero .eyebrow {
    color: #efaaa5;
  }

  .immersive-hero h1 {
    margin: 0;
    color: white;
    font-size: clamp(2.8rem, 5vw, 4.9rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
    text-shadow: 0 5px 28px rgb(8 15 23 / 28%);
  }

  .immersive-hero h1 span {
    display: block;
  }

  .immersive-hero__copy > p:not(.eyebrow) {
    max-width: 610px;
    margin: 28px 0 0;
    color: rgb(255 255 255 / 82%);
    font-size: 1.08rem;
  }

  @media (max-width: 720px) {
    .immersive-hero {
      min-height: calc(100svh - 103px);
    }

    .immersive-hero__image {
      object-position: 43% center;
    }

    .immersive-hero__overlay {
      background:
        linear-gradient(0deg, rgb(30 40 54 / 98%) 0%, rgb(48 61 80 / 86%) 54%, rgb(64 80 102 / 18%) 100%),
        linear-gradient(90deg, rgb(36 48 64 / 44%), transparent);
    }

    .immersive-hero__content {
      align-items: flex-end;
      padding-block: 230px 72px;
    }

    .immersive-hero h1 {
      font-size: clamp(2.25rem, 10vw, 3.1rem);
      letter-spacing: -0.045em;
    }

    .immersive-hero__copy > p:not(.eyebrow) {
      margin-top: 22px;
      font-size: 1rem;
    }
  }
</style>
