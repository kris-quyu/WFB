---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ScenarioGrid from '../../components/ScenarioGrid.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import { getScenariosForProduct } from '../../data/content';
import { products } from '../../data/products';
import { siteConfig } from '../../data/site';
const crumbs = [{ label: '首页', href: '/' }, { label: '应用场景', href: '/applications/' }];
---
<BaseLayout title={`应用场景｜${siteConfig.shortName}`} description="按18个具体采购问题梳理无纺布、针刺布与土工布的选型重点、候选产品和询价资料。" canonicalPath="/applications/" breadcrumbs={crumbs}>
  <PageHero eyebrow="选型思路" title="应用场景" description="按具体用途和采购问题整理无纺布、针刺布与土工布的选型重点、候选产品和询价资料。" breadcrumbs={crumbs}/>
  <div class="scenario-directory">
    {products.map((product, index) => (
      <section class:list={['section', { 'section--warm': index % 2 === 1 }]}>
        <div class="container">
          <div class="section-heading">
            <p class="section-heading__eyebrow">{product.displayName.toUpperCase()}</p>
            <h2>{product.displayName}应用问题</h2>
            <p>围绕{product.displayName}常见使用场景，说明选型时应关注的条件以及询价前需要准备的信息。</p>
          </div>
          <ScenarioGrid scenarios={getScenariosForProduct(product.slug)} linkToProduct />
        </div>
      </section>
    ))}
  </div>
  <div class="container section"><ContactPanel /></div>
</BaseLayout>

<style>
  .scenario-directory :global(.section-heading) { max-width: 820px; }
  .scenario-directory :global(.section-heading > p:last-child) { color: var(--color-muted); }
</style>
