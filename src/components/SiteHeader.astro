---
import { navigation, siteConfig } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="topline">
    <div class="container topline__inner">
      <span>企业资料核实中 · 当前为网站建设版本</span>
      <span>{siteConfig.factoryAddress}</span>
    </div>
  </div>
  <div class="container header-main">
    <a class="brand" href="/" aria-label="返回企业首页">
      <span class="brand__name">{siteConfig.shortName}</span>
      <span class="brand__descriptor">NONWOVEN · MANUFACTURING</span>
    </a>
    <button class="menu-button" type="button" aria-controls="primary-navigation" aria-expanded="false">
      <span>菜单</span>
    </button>
    <nav id="primary-navigation" class="primary-nav" aria-label="主要导航">
      <ul>
        {navigation.map((item) => (
          <li>
            <a class:list={[{ active: currentPath === item.href }]} href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const navigation = document.querySelector<HTMLElement>('#primary-navigation');

  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    navigation?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--color-line);
    background: rgb(255 254 250 / 96%);
    backdrop-filter: blur(12px);
  }

  .topline {
    color: #dfe9e3;
    background: var(--color-forest-dark);
    font-size: 0.78rem;
  }

  .topline__inner {
    display: flex;
    min-height: 30px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .header-main {
    display: flex;
    min-height: 82px;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: grid;
    min-width: 250px;
    color: var(--color-forest-dark);
  }

  .brand__name {
    overflow: hidden;
    max-width: 360px;
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand__descriptor {
    color: var(--color-muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .primary-nav {
    margin-left: auto;
  }

  .primary-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 17px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav a {
    display: block;
    padding: 7px 0;
    color: var(--color-forest-dark);
    font-size: 0.91rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .primary-nav a:hover,
  .primary-nav a.active {
    box-shadow: inset 0 -3px 0 var(--color-accent);
  }

  .menu-button {
    display: none;
    flex-shrink: 0;
    margin-left: auto;
    padding: 9px 14px;
    border: 1px solid var(--color-forest);
    color: var(--color-forest);
    background: transparent;
    font-weight: 750;
  }

  @media (max-width: 1080px) {
    .header-main {
      position: relative;
      min-height: 72px;
    }

    .menu-button {
      display: block;
    }

    .primary-nav {
      position: absolute;
      top: 100%;
      right: 20px;
      left: 20px;
      display: none;
      padding: 14px 20px 22px;
      border: 1px solid var(--color-line);
      background: var(--color-paper);
      box-shadow: var(--shadow-low);
    }

    .primary-nav.is-open {
      display: block;
    }

    .primary-nav ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      justify-content: stretch;
    }
  }

  @media (max-width: 700px) {
    .topline__inner span:last-child,
    .brand__descriptor {
      display: none;
    }

    .brand {
      min-width: 0;
      max-width: calc(100vw - 130px);
    }

    .brand__name {
      font-size: 0.95rem;
    }

    .primary-nav {
      right: 14px;
      left: 14px;
    }

    .primary-nav ul {
      grid-template-columns: 1fr;
    }
  }
</style>
