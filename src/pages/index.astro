---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import PhotoEvidence from '../components/PhotoEvidence.astro';
import PlaceholderNotice from '../components/PlaceholderNotice.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { products } from '../data/products';
import { applications, faqItems } from '../data/content';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`无纺布产品与生产资料｜${siteConfig.shortName}`}
  description="传统小型无纺布生产企业官网建设版本，集中展示产品、生产现场、设备、质量流程、应用与采购知识。"
>
  <section class="home-hero">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">NONWOVEN MANUFACTURING</p>
        <h1>
          <span>把产品参数、</span>
          <span>生产现场和</span>
          <span>质量流程说清楚</span>
        </h1>
        <p>{siteConfig.description}</p>
        <div class="button-row">
          <a class="button" href="#products">查看产品资料</a>
          <a class="button button--outline" href="#contact">准备询价信息</a>
        </div>
      </div>
      <PhotoEvidence
        src="/images/nonwoven-production-line.png"
        alt="绿色无纺布生产设备正在加工白色卷材的现场照片"
        label="生产现场"
        caption="用户提供的设备现场图。设备名称、型号、数量与工艺作用仍待企业确认。"
      />
    </div>
  </section>

  <section id="products" class="section">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">产品中心</p>
        <h2>三个独立产品入口</h2>
        <p>每类产品都有独立页面，便于采购人员、搜索引擎和生成式搜索理解产品与参数。</p>
      </div>
      <div class="grid grid--3">{products.map((product) => <ProductCard product={product} />)}</div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">能力证据</p>
        <h2>先看可核实的资料</h2>
        <p>不使用夸张口号，用真实现场、设备用途、检查流程和记录方式说明企业能力。</p>
      </div>
      <div class="grid grid--3">
        <EvidenceCard index="01" title="工厂实力" description="展示生产、原料、仓储和发货环节；具体规模数据等待企业核实。" href="/factory/" />
        <EvidenceCard index="02" title="生产设备" description="展示用户提供的设备现场，并为设备名称、型号和数量保留核实字段。" href="/equipment/" />
        <EvidenceCard index="03" title="质量检测" description="先展示通用检查流程，实际标准、设备和频次以企业资料为准。" href="/quality/" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">应用场景</p>
        <h2>从用途反推产品要求</h2>
      </div>
      <div class="grid grid--3">
        {applications.slice(0, 6).map((item) => <article class="card"><h3>{item.name}</h3><p>{item.focus}</p><p><strong>询价准备：</strong>{item.inquiryInput}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container faq-preview">
      <div class="section-heading">
        <p class="section-heading__eyebrow">常见问题</p>
        <h2>采购前经常需要确认</h2>
      </div>
      <div>
        {faqItems.slice(0, 3).map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        <a class="button button--outline" href="/knowledge/">查看全部 FAQ 与知识文章</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container"><PlaceholderNotice /></div>
  </section>
  <div id="contact" class="container section"><ContactPanel /></div>
</BaseLayout>

<style>
  .home-hero {
    padding-block: clamp(48px, 7vw, 94px);
    background: var(--color-warm-gray);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1.28fr;
    gap: clamp(28px, 5vw, 70px);
    align-items: center;
  }

  .home-hero__grid > * {
    min-width: 0;
  }

  .home-hero h1 {
    margin: 0;
    font-size: clamp(2.4rem, 4.2vw, 4.2rem);
    line-height: 1.06;
    letter-spacing: -0.055em;
    overflow-wrap: anywhere;
  }

  .home-hero h1 span {
    display: block;
  }

  .home-hero__copy > p:not(.eyebrow) {
    margin: 26px 0;
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .faq-preview {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 60px;
  }

  details {
    border-top: 1px solid var(--color-line);
  }

  summary {
    padding: 18px 0;
    color: var(--color-forest-dark);
    font-weight: 800;
    cursor: pointer;
  }

  details p {
    margin-top: 0;
    color: var(--color-muted);
  }

  @media (max-width: 880px) {
    .home-hero__grid,
    .faq-preview {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .home-hero h1 {
      font-size: 2.12rem;
      letter-spacing: -0.035em;
    }
  }
</style>
