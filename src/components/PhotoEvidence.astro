---
interface Props {
  src: string;
  alt: string;
  caption: string;
  label?: string;
  wide?: boolean;
}

const { src, alt, caption, label = '真实现场资料', wide = false } = Astro.props;
---

<figure class:list={['photo-evidence', { 'photo-evidence--wide': wide }]}> 
  <img src={src} alt={alt} width="1680" height="945" loading="lazy" decoding="async" />
  <figcaption>
    <strong>{label}</strong>
    <span>{caption}</span>
  </figcaption>
</figure>

<style>
  .photo-evidence {
    margin: 0;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    box-shadow: var(--shadow-low);
  }

  img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .photo-evidence--wide img {
    aspect-ratio: 21 / 9;
  }

  figcaption {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) 1fr;
    gap: 20px;
    padding: 18px 22px;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  strong {
    color: var(--color-forest);
  }

  @media (max-width: 640px) {
    .photo-evidence--wide img {
      aspect-ratio: 4 / 3;
    }

    figcaption {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
