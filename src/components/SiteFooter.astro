---
import { navigation, siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{siteConfig.companyName}</p>
      <p>{siteConfig.description}</p>
    </div>
    <div>
      <h2>联系信息</h2>
      <ul>
        <li>电话：{siteConfig.phone}</li>
        <li>邮箱：{siteConfig.email}</li>
        <li>工厂：{siteConfig.factoryAddress}</li>
      </ul>
    </div>
    <div>
      <h2>快速访问</h2>
      <ul class="footer-links">
        {navigation.slice(0, 6).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container legal">
    <span>© {new Date().getFullYear()} {siteConfig.companyName}</span>
    <span>{siteConfig.icpNumber}</span>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: 60px;
    color: #e8eee9;
    background: var(--color-forest-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr 0.8fr;
    gap: 48px;
  }

  .footer-grid p,
  .footer-grid li {
    color: #bdcac2;
  }

  .footer-brand {
    margin-top: 0;
    color: white !important;
    font-size: 1.25rem;
    font-weight: 850;
  }

  h2 {
    margin-top: 0;
    color: white;
    font-size: 0.95rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 18px;
  }

  a:hover {
    color: white;
  }

  .legal {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 44px;
    padding-block: 18px;
    border-top: 1px solid rgb(255 255 255 / 12%);
    color: #99aaa0;
    font-size: 0.78rem;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .legal {
      flex-direction: column;
    }
  }
</style>
