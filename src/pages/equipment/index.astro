---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PhotoEvidence from '../../components/PhotoEvidence.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import { siteConfig } from '../../data/site';
import { withBase } from '../../utils/path';
const crumbs = [{ label: '首页', href: '/' }, { label: '生产设备', href: '/equipment/' }];
---

<BaseLayout title={`生产设备｜${siteConfig.shortName}`} description="查看天瑞无纺布实际生产现场，以及用于日常加工、成卷和产品整理的普通生产与辅助设备说明。" canonicalPath="/equipment/" breadcrumbs={crumbs}>
  <PageHero eyebrow="生产现场" title="生产设备" description="常规生产与卷材整理设备用于无纺材料加工、成卷和订单交付。" breadcrumbs={crumbs}/>
  <section class="section">
    <div class="container equipment-layout">
      <PhotoEvidence src={withBase('/images/equipment-finished-roll-line.png')} alt="无纺材料卷材整理设备与白色卷材现场" label="卷材整理现场" caption="现场照片记录了材料加工、成卷和产品整理作业；实际适配规格以订单沟通为准。" />
      <div class="equipment-copy">
        <p class="eyebrow">EQUIPMENT</p>
        <h2>常规生产与卷材整理设备</h2>
        <p>采购时更重要的是先确认产品用途、材质、克重、幅宽、卷长和数量，再结合生产安排判断是否适配。</p>
        <p>如需了解某项加工方式，可将样品、图片或规格表通过微信发给我们核对。</p>
      </div>
    </div>
  </section>
  <section class="section section--warm">
    <div class="container equipment-layout">
      <PhotoEvidence src={withBase('/images/equipment-card-web-processing.png')} alt="无纺材料加工设备局部与控制区域现场" label="设备局部现场" caption="现场照片用于展示加工设备与作业环境，不作为型号、产能或联系方式说明。" />
      <div class="equipment-copy">
        <p class="eyebrow">ON-SITE VIEW</p>
        <h2>加工设备与作业区域</h2>
        <p>设备照片用于展示实际生产环境。具体材料、规格和加工要求仍需结合样品、用途与订单内容沟通确认。</p>
      </div>
    </div>
  </section>
  <div class="container section"><ContactPanel /></div>
</BaseLayout>

<style>
  .equipment-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); gap: clamp(34px, 6vw, 78px); align-items: center; }
  .equipment-copy h2 { margin: 0; font-size: clamp(1.8rem, 3.5vw, 3rem); line-height: 1.2; }
  .equipment-copy p:not(.eyebrow) { color: var(--color-muted); }
  @media (max-width: 820px) { .equipment-layout { grid-template-columns: 1fr; } }
</style>
