---
import { navigation, siteConfig } from '../data/site';
import { withBase, withoutBase } from '../utils/path';

const currentPath = withoutBase(Astro.url.pathname);
const activeSection = currentPath === '/'
  ? ''
  : navigation.find((item) => item.href.includes(currentPath.split('/').filter(Boolean)[0] ?? ''))?.href.split('#')[1];
---

<header class="site-header">
  <div class="topline">
    <div class="container topline__inner">
      <span>企业主体资料已核实 · 产品规格请电话或微信确认</span>
      <span>{siteConfig.factoryAddress}</span>
    </div>
  </div>
  <div class="container header-main">
    <a class="brand" href={withBase('/')} aria-label="返回企业首页">
      <span class="brand__name">{siteConfig.shortName}</span>
      <span class="brand__descriptor">NONWOVEN · MANUFACTURING</span>
    </a>
    <button class="menu-button" type="button" aria-controls="primary-navigation" aria-expanded="false">
      <span>菜单</span>
    </button>
    <nav id="primary-navigation" class="primary-nav" aria-label="主要导航">
      <ul>
        {navigation.map((item) => (
          <li>
            <a
              class:list={[{ active: item.href === withBase('/') ? currentPath === '/' : item.href.endsWith(`#${activeSection}`) }]}
              href={item.href}
              data-section-link={item.href.includes('#') ? item.href.split('#')[1] : 'home'}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const navigation = document.querySelector<HTMLElement>('#primary-navigation');
  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];

  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    navigation?.classList.toggle('is-open', !open);
  });

  sectionLinks.forEach((link) => {
    link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      navigation?.classList.remove('is-open');
    });
  });

  const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
  if (window.location.pathname === basePath || window.location.pathname === `${basePath}index.html`) {
    const sections = [...document.querySelectorAll<HTMLElement>('main > [data-scroll-section]')];
    const setActive = (id: string) => {
      sectionLinks.forEach((link) => link.classList.toggle('active', link.dataset.sectionLink === id));
    };

    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      const id = (visible?.target as HTMLElement | undefined)?.dataset.scrollSection;
      if (id) setActive(id);
    }, { rootMargin: '-25% 0px -55% 0px', threshold: [0, 0.1, 0.3] });

    sections.forEach((section) => observer.observe(section));
    if (window.location.hash) setActive(window.location.hash.slice(1));
  }
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--color-line);
    background: rgb(255 254 250 / 96%);
    backdrop-filter: blur(12px);
  }

  .topline {
    color: #e3e8ee;
    background: var(--color-forest-dark);
    font-size: 0.78rem;
  }

  .topline__inner {
    display: flex;
    min-height: 30px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .header-main {
    display: flex;
    min-height: 82px;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: grid;
    min-width: 250px;
    color: var(--color-forest-dark);
  }

  .brand__name {
    overflow: hidden;
    max-width: 360px;
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand__descriptor {
    color: var(--color-muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .primary-nav {
    margin-left: auto;
  }

  .primary-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 17px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav a {
    display: block;
    padding: 7px 0;
    color: var(--color-forest-dark);
    font-size: 0.91rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .primary-nav a:hover,
  .primary-nav a.active {
    box-shadow: inset 0 -3px 0 var(--color-accent);
  }

  .menu-button {
    display: none;
    flex-shrink: 0;
    margin-left: auto;
    padding: 9px 14px;
    border: 1px solid var(--color-forest);
    color: var(--color-forest);
    background: transparent;
    font-weight: 750;
  }

  @media (max-width: 1080px) {
    .header-main {
      position: relative;
      min-height: 72px;
    }

    .menu-button {
      display: block;
    }

    .primary-nav {
      position: absolute;
      top: 100%;
      right: 20px;
      left: 20px;
      display: none;
      padding: 0;
      border: 1px solid var(--color-line);
      background: var(--color-paper);
      box-shadow: var(--shadow-low);
    }

    .primary-nav.is-open {
      display: block;
    }

    .primary-nav ul {
      display: grid;
      grid-template-columns: 1fr;
      justify-content: stretch;
      gap: 0;
    }

    .primary-nav li + li {
      border-top: 1px solid var(--color-line);
    }

    .primary-nav a {
      padding: 16px 28px;
      color: var(--color-ink);
      font-size: 1.08rem;
      font-weight: 500;
    }

    .primary-nav a:hover,
    .primary-nav a.active {
      color: var(--color-forest);
      background: var(--color-warm-gray);
      box-shadow: inset 4px 0 0 var(--color-accent);
    }
  }

  @media (max-width: 700px) {
    .topline__inner span:last-child,
    .brand__descriptor {
      display: none;
    }

    .brand {
      min-width: 0;
      max-width: calc(100vw - 130px);
    }

    .brand__name {
      font-size: 0.95rem;
    }

    .primary-nav {
      right: 14px;
      left: 14px;
    }

    .primary-nav a {
      padding: 15px 20px;
    }
  }
</style>
