---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductShowcase from '../../components/ProductShowcase.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import { siteConfig } from '../../data/site';
---

<BaseLayout
  title={`产品介绍｜${siteConfig.shortName}`}
  description="查看天瑞无纺布、针刺布与土工布实际产品照片、常见用途、选型信息和采购确认事项。"
  canonicalPath="/products/"
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '产品介绍', href: '/products/' },
  ]}
>
  <ProductShowcase />
  <div class="products-followup">
    <section class="section">
      <div class="container product-guidance">
        <p class="eyebrow">选型说明</p>
        <h2>先按用途选择产品，再确认订单规格</h2>
        <p>页面中的原料、工艺和应用属于行业常见选型知识。实际材质、克重、幅宽、颜色、卷长及包装方式，需要结合样品和订单要求确认。</p>
      </div>
    </section>
    <div class="container section"><ContactPanel /></div>
  </div>
</BaseLayout>

<style>
  .products-followup {
    --color-forest: #405066;
    --color-forest-dark: #303d50;
    --color-accent: #b8322a;
    --color-warm-gray: #f2f2f2;
    --color-paper: #f2f2f2;
    background: #f2f2f2;
  }

  .product-guidance {
    max-width: 900px;
  }

  .product-guidance h2 {
    margin: 0;
  }

  .product-guidance > p:last-child {
    color: var(--color-muted);
  }
</style>
