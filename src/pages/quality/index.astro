---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PlaceholderNotice from '../../components/PlaceholderNotice.astro';
import { qualitySteps } from '../../data/content';
import { siteConfig } from '../../data/site';
const crumbs = [{ label: '首页', href: '/' }, { label: '质量检测', href: '/quality/' }];
---
<BaseLayout title={`质量检测｜${siteConfig.shortName}`} description="展示来料、过程、成品和留样记录的通用质量流程，具体标准与检测数据待企业确认。" canonicalPath="/quality/" breadcrumbs={crumbs}>
  <PageHero eyebrow="质量流程" title="质量检测" description="这里先区分通用流程与企业真实能力，避免把模板内容误写成认证或检测结论。" breadcrumbs={crumbs}/>
  <section class="section"><div class="container"><div class="section-heading"><p class="section-heading__eyebrow">通用流程</p><h2>从来料到成品记录</h2><p>以下是制造企业常见的质量控制框架，并不代表企业已实施全部项目。</p></div><ol class="quality-flow">{qualitySteps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{step.title}</h2><p>{step.description}</p></div></li>)}</ol></div></section>
  <section class="section section--warm"><div class="container grid grid--2"><article class="card"><h2>待企业确认：检测项目</h2><p>克重、幅宽、厚度、强力、伸长率、透气性或其他项目是否执行，应以真实设备和记录为准。</p></article><article class="card"><h2>待企业确认：执行标准</h2><p>请提供产品实际执行的国家、行业、团体、客户或企业标准名称与编号。</p></article><article class="card"><h2>待企业确认：检测设备</h2><p>请提供设备正式名称、型号、用途和现场照片。</p></article><article class="card"><h2>待企业确认：记录方式</h2><p>请说明批次、留样、报告和异常处理记录如何保存。</p></article></div></section>
  <section class="section"><div class="container"><PlaceholderNotice title="严禁补写">没有证书原件、检测报告或企业确认资料时，不发布“通过认证”“达到某标准”或具体性能结论。</PlaceholderNotice></div></section>
</BaseLayout>

<style>.quality-flow{display:grid;margin:0;padding:0;list-style:none}.quality-flow li{display:grid;grid-template-columns:80px 1fr;gap:24px;padding:24px 0;border-top:1px solid var(--color-line)}.quality-flow span{color:var(--color-accent);font-size:2rem;font-weight:900}.quality-flow h2{margin:0}.quality-flow p{margin:6px 0 0;color:var(--color-muted)}</style>
