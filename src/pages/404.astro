---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到" description="请求的页面不存在，请返回企业首页。" canonicalPath="/404/">
  <section class="section"><div class="container not-found"><p class="eyebrow">404</p><h1 class="display-title">没有找到这个页面</h1><p>链接可能已调整，或者输入的地址不完整。</p><a class="button" href="/">返回首页</a></div></section>
</BaseLayout>
<style>.not-found{max-width:700px;padding-block:70px}.not-found p:not(.eyebrow){margin:24px 0;color:var(--color-muted)}</style>
