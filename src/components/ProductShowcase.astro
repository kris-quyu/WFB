---
import ProductCard from './ProductCard.astro';
import { products } from '../data/products';
---

<section class="product-showcase section">
  <div class="product-showcase__backdrop" aria-hidden="true"></div>
  <div class="container product-showcase__content">
    <div class="section-heading product-showcase__heading">
      <p class="section-heading__eyebrow">PRODUCT SHOWCASE</p>
      <h1>主营产品介绍</h1>
      <p>无纺布、针刺布与土工布均使用企业提供的实际产品照片展示；具体规格以询价确认为准。</p>
    </div>
    <div class="product-filter" role="group" aria-label="选择要查看的产品">
      <button type="button" data-product-filter="all" aria-pressed="true" aria-controls="product-grid">全部产品</button>
      {products.map((product) => (
        <button type="button" data-product-filter={product.slug} aria-pressed="false" aria-controls={product.slug}>
          {product.displayName}
        </button>
      ))}
    </div>
    <div id="product-grid" class="product-showcase__grid">{products.map((product) => <ProductCard product={product} />)}</div>
  </div>
</section>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-product-filter]'));
  const productCards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-card]'));

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.dataset.productFilter;

      filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      productCards.forEach((card) => card.classList.toggle('is-highlighted', card.dataset.productCard === target));

      if (target && target !== 'all') {
        document.querySelector<HTMLElement>(`[data-product-card="${target}"]`)?.scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        });
      }
    });
  });
</script>

<style>
  .product-showcase {
    --showcase-red: #b8322a;
    --showcase-slate: #405066;
    --showcase-ink: #1f2429;
    --showcase-paper: #f2f2f2;
    position: relative;
    min-height: calc(100svh - 112px);
    overflow: hidden;
    color: white;
    background: var(--showcase-slate);
    isolation: isolate;
  }

  .product-showcase::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(180deg, rgb(45 57 75 / 64%), rgb(27 36 49 / 89%));
    content: '';
  }

  .product-showcase__backdrop {
    position: absolute;
    z-index: -2;
    inset: -32px;
    background: url('/images/nonwoven-production-line.png') center / cover no-repeat;
    filter: blur(15px) saturate(72%);
    opacity: 0.72;
    transform: scale(1.06);
  }

  .product-showcase__content {
    position: relative;
  }

  .product-showcase__heading {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .product-showcase__heading .section-heading__eyebrow {
    color: #efaaa5;
  }

  .product-showcase__heading h1 {
    margin: 0;
    color: white;
    font-size: clamp(2.3rem, 4.2vw, 3.9rem);
    line-height: 1.14;
    letter-spacing: -0.035em;
  }

  .product-showcase__heading p {
    margin-inline: auto;
    color: rgb(255 255 255 / 74%);
  }

  .product-filter {
    display: flex;
    max-width: 820px;
    justify-content: center;
    gap: 12px;
    margin: 0 auto 38px;
  }

  .product-filter button {
    min-height: 42px;
    padding: 8px 23px;
    border: 1px solid rgb(255 255 255 / 50%);
    border-radius: 999px;
    color: var(--showcase-ink);
    background: rgb(242 242 242 / 94%);
    font-weight: 750;
    white-space: nowrap;
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .product-filter button:hover {
    transform: translateY(-2px);
  }

  .product-filter button[aria-pressed='true'] {
    border-color: var(--showcase-red);
    color: white;
    background: var(--showcase-red);
  }

  .product-showcase__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  @media (max-width: 880px) {
    .product-showcase__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .product-showcase {
      min-height: 0;
      padding-block: 72px;
    }

    .product-filter {
      max-width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
      padding: 4px 2px 12px;
      scrollbar-width: thin;
    }

    .product-filter button {
      flex: 0 0 auto;
    }

    .product-showcase__grid {
      gap: 16px;
    }
  }
</style>
