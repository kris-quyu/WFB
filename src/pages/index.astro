---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import PhotoEvidence from '../components/PhotoEvidence.astro';
import ScenarioGrid from '../components/ScenarioGrid.astro';
import { siteConfig } from '../data/site';
import { products } from '../data/products';
import { faqItems, featuredScenarios, knowledgeArticles } from '../data/content';
---

<BaseLayout
  title={`广州无纺布、针刺布与土工布｜${siteConfig.companyName}`}
  description="广州市天瑞无纺布有限公司成立于2004年，位于广州白云区，供应无纺布、针刺布和土工布，可按用途、样品或图片沟通规格。"
>
  <section class="immersive-hero" data-scroll-section="home">
    <img
      class="immersive-hero__image"
      src="/images/nonwoven-production-line.png"
      alt="无纺布生产设备正在加工白色卷材的现场照片"
      width="1680"
      height="945"
      fetchpriority="high"
    />
    <div class="immersive-hero__overlay" aria-hidden="true"></div>
    <div class="container immersive-hero__content">
      <div class="immersive-hero__copy">
        <p class="eyebrow">NONWOVEN MANUFACTURING</p>
        <h1><span>广州无纺布、针刺布</span><span>与土工布生产供应</span></h1>
        <p>广州市天瑞无纺布有限公司成立于2004年，位于广州市白云区，主要供应无纺布、针刺布和土工布。询价时可提供用途、参考样品或图片和目标规格。</p>
      </div>
    </div>
  </section>

  <section id="about" class="home-section home-section--paper" data-scroll-section="about">
    <div class="container split-layout">
      <div class="section-heading">
        <p class="section-heading__eyebrow">ABOUT US</p>
        <h2>关于我们</h2>
        <p>企业名称、成立日期和地址按营业执照信息整理；主营产品与联系方式按企业提供资料公开。</p>
      </div>
      <div class="evidence-panel">
        <p class="evidence-panel__label">企业概况</p>
        <h3>2004年成立，主体地址和主营产品可核对</h3>
        <p>公司位于广州市白云区，主要供应无纺布、针刺布和土工布。采购前可先说明用途，提供参考样品或图片、克重、幅宽、颜色和数量，再核对产品与交付安排。</p>
        <a class="section-link" href="/about/">查看企业介绍详情</a>
      </div>
    </div>
  </section>

  <section id="products" class="home-section home-section--warm" data-scroll-section="products">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">PRODUCTS</p>
        <h2>产品中心</h2>
        <p>三类主营产品均使用企业提供的实际照片。无纺布重点看材质与后加工，针刺布需结合厚度、手感和工况，土工布应按工程设计指标与铺设条件核对。</p>
      </div>
      <div class="grid grid--3 product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
      <a class="section-link section-link--standalone" href="/products/">查看完整产品介绍</a>
    </div>
  </section>

  <section id="factory" class="home-section home-section--paper" data-scroll-section="factory">
    <div class="container factory-layout">
      <div>
        <div class="section-heading">
          <p class="section-heading__eyebrow">FACTORY</p>
          <h2>从需求确认到卷材交付</h2>
          <p>一张询价单先核对用途、参考样品、材质、克重、幅宽、卷长、数量和包装要求，再结合实际生产安排确认交付。</p>
        </div>
        <ul class="fact-list compact-facts">
          <li><strong>生产现场</strong>无纺布卷材加工与收卷现场</li>
          <li><strong>成立时间</strong>2004年6月1日</li>
          <li><strong>工厂地址</strong>{siteConfig.factoryAddress}</li>
        </ul>
        <a class="section-link section-link--standalone" href="/factory/">查看工厂资料详情</a>
      </div>
      <PhotoEvidence
        src="/images/nonwoven-production-line.png"
        alt="无纺布生产线与白色卷材的真实现场"
        label="无纺布卷材生产现场"
        caption="照片展示无纺材料加工、卷材整理与收卷现场。产品是否适合仍需根据用途、样品和订单规格判断。"
      />
    </div>
  </section>

  <section id="equipment" class="home-section home-section--slate" data-scroll-section="equipment">
    <div class="container">
      <div class="section-heading section-heading--light">
        <p class="section-heading__eyebrow">EQUIPMENT</p>
        <h2>生产设备</h2>
        <p>现有照片展示无纺材料加工、卷材整理和收卷环节。设备型号不代替产品参数，采购仍应先核对用途与规格。</p>
      </div>
      <div class="equipment-summary">
        <img src="/images/nonwoven-production-line.png" alt="天瑞无纺布生产线与白色卷材现场" width="1680" height="945" loading="lazy" />
        <p>询价时可提供用途、参考样品或图片、材质、克重、幅宽、卷长和数量；如有后加工、测试或包装要求，也应一并说明。</p>
      </div>
      <a class="section-link section-link--light section-link--standalone" href="/equipment/">查看生产设备详情</a>
    </div>
  </section>

  <section id="applications" class="home-section home-section--warm" data-scroll-section="applications">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">APPLICATIONS</p>
        <h2>应用领域</h2>
        <p>以下 6 个代表性问题分别说明包装、家具、过滤和工程铺设等场景需要提供的用途、工况、样品或设计资料；完整内容收录在应用页和产品详情页。</p>
      </div>
      <ScenarioGrid scenarios={featuredScenarios} compact linkToProduct />
      <a class="section-link section-link--standalone" href="/applications/">查看应用领域详情</a>
    </div>
  </section>

  <section id="knowledge" class="home-section home-section--paper" data-scroll-section="knowledge">
    <div class="container knowledge-layout">
      <div class="section-heading">
        <p class="section-heading__eyebrow">KNOWLEDGE</p>
        <h2>知识中心</h2>
        <p>不知道材质或规格时，可以从最终用途、现用样品、成品尺寸、后加工方式和收货地点开始整理询价信息。</p>
        <a class="section-link section-link--standalone" href={`/knowledge/${knowledgeArticles[0].slug}/`}>阅读采购清单</a>
      </div>
      <div class="faq-list">
        {faqItems.slice(0, 4).map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
        <a class="section-link section-link--standalone" href="/knowledge/">查看全部 FAQ 与知识文章</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .immersive-hero {
    --showcase-slate: #405066;
    position: relative;
    min-height: calc(100svh - 112px);
    overflow: hidden;
    color: white;
    background: var(--showcase-slate);
    isolation: isolate;
  }

  .immersive-hero__image,
  .immersive-hero__overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
  .immersive-hero__image { z-index: -2; object-fit: cover; object-position: center; }
  .immersive-hero__overlay {
    z-index: -1;
    background: linear-gradient(90deg, rgb(31 43 58 / 94%) 0%, rgb(64 80 102 / 76%) 47%, rgb(64 80 102 / 18%) 100%), linear-gradient(0deg, rgb(22 30 41 / 38%) 0%, transparent 48%);
  }
  .immersive-hero__content { display: flex; min-height: inherit; align-items: center; padding-block: clamp(64px, 8vw, 112px); }
  .immersive-hero__copy { max-width: 690px; }
  .immersive-hero .eyebrow { color: #efaaa5; }
  .immersive-hero h1 { margin: 0; color: white; font-size: clamp(2.8rem, 5vw, 4.9rem); line-height: 1.04; letter-spacing: -0.055em; text-shadow: 0 5px 28px rgb(8 15 23 / 28%); }
  .immersive-hero h1 span { display: block; }
  .immersive-hero__copy > p:not(.eyebrow) { max-width: 610px; margin: 28px 0 0; color: rgb(255 255 255 / 82%); font-size: 1.08rem; }

  .home-section { scroll-margin-top: 112px; padding-block: clamp(80px, 9vw, 128px); }
  .home-section--paper { background: var(--color-paper); }
  .home-section--warm { background: var(--color-warm-gray); }
  .home-section--slate { color: white; background: var(--color-forest); }
  .split-layout, .factory-layout, .knowledge-layout { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(40px, 7vw, 96px); align-items: center; }
  .factory-layout { grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr); }
  .section-heading { margin-bottom: 46px; }
  .split-layout .section-heading, .knowledge-layout .section-heading { margin-bottom: 0; }
  .evidence-panel { padding: clamp(30px, 5vw, 56px); border-left: 4px solid var(--color-accent); background: var(--color-warm-gray); }
  .evidence-panel__label { margin: 0; color: var(--color-accent); font-weight: 800; letter-spacing: .12em; }
  .evidence-panel h3 { margin: 10px 0 18px; font-size: clamp(1.55rem, 3vw, 2.25rem); line-height: 1.3; }
  .section-link { display: inline-block; color: var(--color-accent); font-weight: 800; border-bottom: 1px solid currentColor; }
  .section-link--standalone { margin-top: 28px; }
  .section-link--light { color: #fff; }
  .product-grid :global(.product-card) { box-shadow: none; }
  .compact-facts { margin-top: 10px; }
  .factory-layout :global(.photo-evidence) { min-width: 0; }
  .section-heading--light h2, .section-heading--light p { color: white; }
  .section-heading--light .section-heading__eyebrow { color: #efaaa5; }
  .equipment-summary { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(260px, .7fr); align-items: stretch; border: 1px solid rgb(255 255 255 / 22%); background: rgb(255 255 255 / 7%); }
  .equipment-summary img { width: 100%; height: 100%; min-height: 280px; object-fit: cover; }
  .equipment-summary p { display: flex; align-items: center; margin: 0; padding: clamp(28px, 5vw, 54px); color: rgb(255 255 255 / 78%); }
  .faq-list details { border-top: 1px solid var(--color-line); }
  .faq-list details:last-of-type { border-bottom: 1px solid var(--color-line); }
  .faq-list summary { padding: 20px 0; cursor: pointer; font-size: 1.05rem; font-weight: 800; }
  .faq-list details p { margin: 0 0 20px; color: var(--color-muted); }

  @media (max-width: 900px) {
    .split-layout, .factory-layout, .knowledge-layout { grid-template-columns: 1fr; }
    .equipment-summary { grid-template-columns: 1fr; }
  }

  @media (max-width: 720px) {
    .immersive-hero { min-height: calc(100svh - 103px); }
    .immersive-hero__image { object-position: 43% center; }
    .immersive-hero__overlay { background: linear-gradient(0deg, rgb(30 40 54 / 98%) 0%, rgb(48 61 80 / 86%) 54%, rgb(64 80 102 / 18%) 100%), linear-gradient(90deg, rgb(36 48 64 / 44%), transparent); }
    .immersive-hero__content { align-items: flex-end; padding-block: 230px 72px; }
    .immersive-hero h1 { font-size: clamp(2.25rem, 10vw, 3.1rem); letter-spacing: -0.045em; }
    .immersive-hero__copy > p:not(.eyebrow) { margin-top: 22px; font-size: 1rem; }
    .home-section { scroll-margin-top: 102px; padding-block: 68px; }
  }
</style>
