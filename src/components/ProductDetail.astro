---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import SpecTable from './SpecTable.astro';
import ScenarioGrid from './ScenarioGrid.astro';
import ContactPanel from './ContactPanel.astro';
import type { Product } from '../data/products';
import { getScenariosForProduct } from '../data/content';
import { siteConfig } from '../data/site';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const path = `/products/${product.slug}/`;
const crumbs = [
  { label: '首页', href: '/' },
  { label: product.displayName, href: path },
];
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.displayName,
  description: product.summary,
  material: product.material,
  image: new URL(product.image, siteConfig.siteUrl).toString(),
  category: product.displayName,
  url: new URL(path, siteConfig.siteUrl).toString(),
};
const scenarios = getScenariosForProduct(product.slug);
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: scenarios.map((scenario) => ({
    '@type': 'Question',
    name: scenario.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `${scenario.issue} 选型时重点确认：${scenario.focus.join('、')}。询价需提供：${scenario.inquiryInput.join('、')}。`,
    },
  })),
};
---

<BaseLayout
  title={`${product.displayName}｜${siteConfig.shortName}`}
  description={product.summary}
  canonicalPath={path}
  breadcrumbs={crumbs}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <PageHero
    eyebrow="产品资料"
    title={product.displayName}
    description={product.summary}
    breadcrumbs={crumbs}
  />
  <section class="section">
    <div class="container product-intro grid grid--2">
      <figure class="product-photo">
        <img src={product.image} alt={product.imageAlt} width="1254" height="1254" loading="eager" />
        <figcaption>企业提供的{product.displayName}实际产品照片</figcaption>
      </figure>
      <div>
        <div class="section-heading">
          <p class="section-heading__eyebrow">产品说明</p>
          <h2>先判断用途，再谈材料和参数</h2>
        </div>
        <dl class="definition-list">
          <div><dt>行业常见原料</dt><dd>{product.material}</dd></div>
          <div><dt>行业常见工艺</dt><dd>{product.process}</dd></div>
          <div><dt>包装确认项</dt><dd>{product.packaging}</dd></div>
        </dl>
        <p class="selection-note">这里的原料与工艺用于解释行业常见选型方向，不表示企业供应全部类型。实际产品应按用途、样品、目标参数和订单要求逐项核对。</p>
      </div>
    </div>
  </section>
  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">规格参数</p>
        <h2>先写清使用条件，再核对可做规格</h2>
      </div>
      <SpecTable rows={product.specifications} caption={`${product.displayName} 参数表`} />
    </div>
  </section>
  <section class="section">
    <div class="container grid grid--3">
      <article class="card"><h2>选型边界</h2><ul>{product.features.map((item) => <li>{item}</li>)}</ul></article>
      <article class="card"><h2>应用方向</h2><ul>{product.applications.map((item) => <li>{item}</li>)}</ul></article>
      <article class="card"><h2>可讨论定制项</h2><ul>{product.customization.map((item) => <li>{item}</li>)}</ul></article>
    </div>
  </section>
  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">常见应用问题</p>
        <h2>{product.displayName}在不同场景中怎么选</h2>
        <p>根据实际用途整理选型重点和询价资料，具体规格仍需结合样品、设计要求或订单确认。</p>
      </div>
      <ScenarioGrid scenarios={scenarios} />
    </div>
  </section>
  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="section-heading__eyebrow">采购清单</p>
        <h2>联系厂家前，请准备这些信息</h2>
      </div>
      <ol class="purchase-list">{product.purchaseChecklist.map((item) => <li>{item}</li>)}</ol>
    </div>
  </section>
  <div class="container section"><ContactPanel /></div>
</BaseLayout>

<style>
  .product-intro {
    align-items: start;
  }

  .definition-list {
    margin: 0;
  }

  .selection-note {
    margin-top: 22px;
    padding: 18px 20px;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
    background: var(--color-warm-gray);
  }

  .product-photo {
    margin: 0;
    border: 1px solid var(--color-line);
    background: white;
  }

  .product-photo img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .product-photo figcaption {
    padding: 12px 16px;
    color: var(--color-muted);
    font-size: 0.86rem;
  }

  .definition-list div {
    display: grid;
    grid-template-columns: 90px 1fr;
    padding: 13px 0;
    border-bottom: 1px solid var(--color-line);
  }

  dt {
    color: var(--color-muted);
  }

  dd {
    margin: 0;
    font-weight: 650;
  }

  li {
    margin-bottom: 8px;
  }

  .purchase-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 36px;
    padding-left: 24px;
  }

  @media (max-width: 700px) {
    .purchase-list {
      grid-template-columns: 1fr;
    }
  }
</style>
